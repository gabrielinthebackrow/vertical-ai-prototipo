# LLM provider (compilare con le vostre chiavi — .env è git-ignored)
# Google AI Studio: aistudio.google.com → Get API key
# ATTENZIONE: piano gratuito = Google può usare i contenuti per migliorare i prodotti.
# Solo documenti pubblici, mai dati di clienti reali.
GOOGLE_API_KEY=

# Provider secondari (fallback / giudice eval — da attivare più avanti)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (se diverso dal provider principale)
VOYAGE_API_KEY=

# Rerank
COHERE_API_KEY=

# Database (Supabase: Project Settings → Database → connection string)
DATABASE_URL=

# Langfuse (tracing/eval — langfuse.com, free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
